# HMAC secret for the gatekeeper server (x-agent-games-signature).
# In production this comes from the Agent Games dashboard ("Rotate Secret").
# If unset, the server uses a LOCAL TEST placeholder only
# ("test-secret-local-only") — never a real platform secret.
AGENT_GAMES_HMAC_SECRET=

# Durable store for the Vercel serverless port (api/agent.js).
# Upstash Redis free tier — copy from the Upstash console (database -> REST API).
# If unset, the serverless handler falls back to an in-memory store and warns:
# fine for local dev/tests, NOT for production (reuse detection breaks
# across serverless instances). Never commit real values.
UPSTASH_REDIS_REST_URL=https://<your-database>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-rest-token>
